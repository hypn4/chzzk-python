/* Chzzk TUI Application Styles */

/* Screen defaults */
Screen {
    background: $surface;
}

/* Common container styles */
Container {
    height: auto;
}

/* Header styling */
#header {
    background: $primary;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

/* Status bar styling */
#status {
    background: $surface-darken-1;
    padding: 0 1;
}

.status-connected {
    color: $success;
}

.status-connecting {
    color: $warning;
}

.status-disconnected {
    color: $error;
}

/* Button styling */
Button {
    width: auto;
}

Button:focus {
    text-style: bold;
}

/* Input styling */
Input {
    border: tall $primary;
}

Input:focus {
    border: tall $accent;
}

Input.-valid {
    border: tall $success;
}

Input.-invalid {
    border: tall $error;
}

/* Label styling */
Label {
    padding: 0;
    margin: 0 0 1 0;
}

/* Panel/Container borders */
.panel {
    border: round $primary;
    padding: 1;
}

/* Footer styling */
Footer {
    background: $surface-darken-1;
}

/* Chat-specific styles */
#chat-container {
    height: 1fr;
}

#chat-messages {
    border: round $primary;
    scrollbar-gutter: stable;
}

/* Note: #chat-input styles are defined in InteractiveChatApp.DEFAULT_CSS */

/* Login-specific styles */
#login-container {
    width: 60;
    border: round $primary;
    padding: 1 2;
}

#login-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#login-description {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

.field-container {
    margin: 1 0;
}

.field-label {
    margin-bottom: 0;
    color: $text;
}

#save-button {
    width: 100%;
    margin-top: 1;
}

#status-message {
    text-align: center;
    margin-top: 1;
    height: 1;
}

/* Message type highlighting */
.donation-message {
    background: $warning-darken-3;
}

.self-message {
    color: $success;
}

/* Scrollbar styling */
Scrollbar {
    background: $surface-darken-1;
}

ScrollbarGutter {
    background: $surface-darken-1;
}
